# Copy this file to .env (same folder) for local runs. .env is git-ignored.
# GitHub Actions uses repo Secrets with the same names instead.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional
# OPENAI_API_KEY=
# IMAGE_PROVIDER=gemini        # gemini | openai | placeholder
# TTS_VOICE=hi-IN-MadhurNeural # female: hi-IN-SwaraNeural
# PRIVACY=private

# YouTube login: local runs reuse channels/DigitalImmortals/token.json automatically.
