# TEMPLATE FOR NEW CHANNELS:
# 1. Copy this file to: .github/workflows/<your_channel_name>_scheduler.yml
# 2. Update the channel name and the cron schedule time below.

name: [CHANNEL_NAME] Daily Scheduler (2026 - 2030)

on:
  schedule:
    # Set your custom cron time (e.g., 04:00 UTC = 9:30 AM IST)
    - cron: '0 4 * * *'
  workflow_dispatch:
    inputs:
      target_date:
        description: 'Target release date (YYYY-MM-DD). Leave blank for next day.'
        required: false
        default: ''

jobs:
  run-channel-batch:
    name: Generate & Schedule [CHANNEL_NAME]
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: Install System Dependencies (FFmpeg)
        run: |
          sudo apt-get update
          sudo apt-get install -y ffmpeg

      - name: Install Python Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install yt-dlp edge-tts google-api-python-client google-auth-oauthlib google-auth-httplib2 gspread requests

      - name: Restore Channel Credentials
        run: |
          CHANNEL_DIR="channels/[CHANNEL_NAME]"
          mkdir -p "${CHANNEL_DIR}"
          
          # Use channel-specific secret
          TOKEN_SECRET="${{ secrets.[CHANNEL_NAME_UPPER]_TOKEN_JSON }}"
          CLIENT_SECRET="${{ secrets.[CHANNEL_NAME_UPPER]_CLIENT_SECRET_JSON }}"
          
          if [ -n "$TOKEN_SECRET" ]; then
            echo "$TOKEN_SECRET" > "${CHANNEL_DIR}/token.json"
          fi
          if [ -n "$CLIENT_SECRET" ]; then
            echo "$CLIENT_SECRET" > "${CHANNEL_DIR}/youtube_client_secret.json"
          fi

      - name: Execute Channel Daily Batch
        run: |
          TARGET_DATE="${{ github.event.inputs.target_date }}"
          echo "Executing [CHANNEL_NAME] Daily Batch Runner..."
          python "channels/[CHANNEL_NAME]/scheduler.py" ${TARGET_DATE}

      - name: Commit State / Logs
        if: always()
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "[CHANNEL_NAME] Autonomous Bot"
          git add -A
          git diff --staged --quiet || (git commit -m "chore([CHANNEL_NAME]): automated daily upload run [skip ci]" && git push)
