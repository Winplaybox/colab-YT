# Local runs (.bat files): copy to .env in the repo root. .env is git-ignored.
# GitHub Actions uses repo Secrets with the same names.

ANTHROPIC_API_KEY=      # yt_brain titles/descriptions + DI/Tiger scripts + weekly insights
GEMINI_API_KEY=         # AI images when no museum/Wikimedia photo fits

# Optional
# OPENAI_API_KEY=       # image backup provider
# YT_BRAIN=off          # turn off metadata rewriting
# ARCHIVE_FIRST=false   # skip museum/Wikimedia and go straight to AI images
# AI_IMAGE_MAX_PER_RUN=40
